<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Norcom.Admin.Converters">
  <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
  <conv:BoolToVisibilityConverter x:Key="BoolVisInvert" Invert="True"/>
  <conv:StringNotEmptyConverter x:Key="TextVis"/>
  <conv:PageVisibilityConverter x:Key="PageVis"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#070A12"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#070A12"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F4FBFF"/>

  <SolidColorBrush x:Key="Ink" Color="#F4FBFF"/>
  <SolidColorBrush x:Key="Muted" Color="#93A4BD"/>
  <SolidColorBrush x:Key="Cyan" Color="#00E5FF"/>
  <SolidColorBrush x:Key="Pink" Color="#FF3DB8"/>
  <SolidColorBrush x:Key="Ok" Color="#7CFFB2"/>
  <SolidColorBrush x:Key="Panel" Color="#10182A"/>
  <SolidColorBrush x:Key="PanelEdge" Color="#1C3148"/>
  <SolidColorBrush x:Key="Field" Color="#0B1220"/>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Field}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="CaretBrush" Value="{StaticResource Cyan}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="{StaticResource Field}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="CaretBrush" Value="{StaticResource Cyan}"/>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource Field}"/>
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Padding" Value="8,5"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#123844"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CyanButton" TargetType="Button">
    <Setter Property="Foreground" Value="#041018"/>
    <Setter Property="Background" Value="{StaticResource Cyan}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Margin" Value="0,0,8,8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PinkButton" TargetType="Button" BasedOn="{StaticResource CyanButton}">
    <Setter Property="Background" Value="{StaticResource Pink}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Pink}"/>
    <Setter Property="Foreground" Value="#1A0612"/>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource CyanButton}">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="#121C2E" BorderBrush="#2A4A62" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavButton" TargetType="Button">
    <Setter Property="Foreground" Value="#D5E7F4"/>
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="BorderBrush" Value="#00000000"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="True">
              <Setter TargetName="Edge" Property="Background" Value="#102833"/>
              <Setter TargetName="Edge" Property="BorderBrush" Value="#00E5FF"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Edge" Property="Background" Value="#0E1C2A"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Pill" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    <Setter Property="Margin" Value="0,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="#1A2436" VerticalAlignment="Center">
              <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#8AA0B8" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
            <TextBlock Text="{TemplateBinding Content}" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="#123844"/>
              <Setter TargetName="Knob" Property="Fill" Value="#00E5FF"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PanelCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Panel}"/>
    <Setter Property="BorderBrush" Value="{StaticResource PanelEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="14"/>
  </Style>
</ResourceDictionary>
