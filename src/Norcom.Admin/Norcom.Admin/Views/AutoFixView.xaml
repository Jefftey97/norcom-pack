<UserControl x:Class="Norcom.Admin.Views.AutoFixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Auto-fix" Style="{StaticResource PageTitle}"/>
    <CheckBox Content="Frozen server notice" IsChecked="{Binding FrozenServerRestart}" Style="{StaticResource Pill}"/>
    <CheckBox Content="Tunnel check" IsChecked="{Binding TunnelReconnect}" Style="{StaticResource Pill}"/>
    <CheckBox Content="Bad-mod rollback" IsChecked="{Binding BadModRollback}" Style="{StaticResource Pill}"/>
    <CheckBox Content="Log cleanup" IsChecked="{Binding DiskLogCleanup}" Style="{StaticResource Pill}"/>
    <CheckBox Content="Broken JSON restore" IsChecked="{Binding BrokenConfigRestore}" Style="{StaticResource Pill}"/>
    <CheckBox Content="Crash alerts" IsChecked="{Binding CrashAlerts}" Style="{StaticResource Pill}"/>
    <TextBlock Text="Type AUTOFIX" Style="{StaticResource Label}" Margin="0,12,0,4"/>
    <TextBox Text="{Binding ConfirmText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
    <Button Content="Run now" Command="{Binding RunNowCommand}" Style="{StaticResource CyanButton}" HorizontalAlignment="Left"/>
    <TextBlock Text="Run now needs AUTOFIX. The timer only posts notices. Jar moves do not rewrite the server pin. Soft restart still needs RESTART and does not kill Java." Foreground="#93A4BD" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
</UserControl>
