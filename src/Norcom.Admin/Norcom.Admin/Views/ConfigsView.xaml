<UserControl x:Class="Norcom.Admin.Views.ConfigsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Configs" Style="{StaticResource PageTitle}"/>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
      <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}"/>
      <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource CyanButton}"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Margin="0,0,12,0"/>
      <TextBox Grid.Column="1" Text="{Binding Editor, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    </Grid>
  </DockPanel>
</UserControl>
