<UserControl x:Class="Norcom.Admin.Views.EconomyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="NORCOM Bank" Style="{StaticResource PageTitle}"/>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
      <Button Content="Refresh" Command="{Binding Bank.RefreshCommand}" Style="{StaticResource GhostButton}"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Bank.Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{StaticResource PanelCard}" Margin="0,0,0,12" BorderBrush="{StaticResource NeonEdge}" BorderThickness="1.5">
          <StackPanel>
            <DockPanel>
              <Border DockPanel.Dock="Right" Width="54" Height="54" CornerRadius="27" BorderBrush="{StaticResource NeonEdge}" BorderThickness="1.5" Background="{StaticResource ButtonFill}">
                <TextBlock Text="{Binding Bank.CurrencySymbol}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel>
                <TextBlock Text="{Binding Bank.HeroName}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Bank.CurrencyName}" Foreground="#93A4BD"/>
                <TextBlock Margin="0,8,0,0"><Run Text="Wallet "/><Run Text="{Binding Bank.HeroWallet, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding Bank.CurrencySymbol, Mode=OneWay}"/></TextBlock>
                <TextBlock><Run Text="Banked "/><Run Text="{Binding Bank.HeroBank, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" "/><Run Text="{Binding Bank.CurrencySymbol, Mode=OneWay}"/></TextBlock>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="Players" Style="{StaticResource Label}"/>
        <ListBox ItemsSource="{Binding Bank.Accounts}" SelectedItem="{Binding Bank.Selected}" MaxHeight="180" Margin="0,0,0,8">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock>
                <Run Text="{Binding Name, Mode=OneWay}"/>
                <Run Text="  wallet "/>
                <Run Text="{Binding Wallet, Mode=OneWay}"/>
                <Run Text="  bank "/>
                <Run Text="{Binding Banked, Mode=OneWay}"/>
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="Amount" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding Bank.AmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
        <TextBlock Text="Transfer to" Style="{StaticResource Label}"/>
        <TextBox Text="{Binding Bank.TransferTo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="Deposit" Command="{Binding Bank.DepositCommand}" Style="{StaticResource CyanButton}"/>
          <Button Content="Withdraw" Command="{Binding Bank.WithdrawCommand}" Style="{StaticResource CyanButton}"/>
          <Button Content="Transfer" Command="{Binding Bank.TransferCommand}" Style="{StaticResource CyanButton}"/>
          <Button Content="Set" Command="{Binding Bank.SetBalanceCommand}" Style="{StaticResource CyanButton}"/>
        </StackPanel>
        <TextBlock Text="{Binding Bank.LedgerNote}" Foreground="#93A4BD" TextWrapping="Wrap" Margin="0,4,0,6"/>
        <ListBox ItemsSource="{Binding Bank.Ledger}" MaxHeight="140" Margin="0,0,0,16"/>
        <TextBlock Text="Mod configs" Style="{StaticResource PageTitle}"/>
        <Button Content="Refresh configs" Command="{Binding Mods.RefreshCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"/>
        <ItemsControl ItemsSource="{Binding Mods.Mods}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource PanelCard}" Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold"><Run Text="{Binding Group, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Title, Mode=OneWay}"/></TextBlock>
                  <TextBlock Text="{Binding Note}" Foreground="#93A4BD" Margin="0,4,0,8"/>
                  <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                          <CheckBox Grid.Column="1" Content="" IsChecked="{Binding Flag}" Style="{StaticResource Pill}" Visibility="{Binding IsBool, Converter={StaticResource BoolVis}}"/>
                          <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsText, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Save" Command="{Binding DataContext.Mods.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource CyanButton}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Mods.Status}" TextWrapping="Wrap" Foreground="#93A4BD"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
