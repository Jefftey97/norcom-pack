<UserControl x:Class="Norcom.Admin.Views.PublishView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="Publish" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="Pack folder" Style="{StaticResource Label}"/>
    <TextBox Text="{Binding PackPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
    <TextBlock Text="Type PUBLISH" Style="{StaticResource Label}"/>
    <TextBox Text="{Binding ConfirmText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
    <Button Content="Publish to main" Command="{Binding PublishCommand}" Style="{StaticResource PinkButton}" HorizontalAlignment="Left"/>
    <TextBlock Text="Normal push only. No force-push. launcher/ stays. Admin is not added to Install-NORCOM." Foreground="#93A4BD" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
</UserControl>
