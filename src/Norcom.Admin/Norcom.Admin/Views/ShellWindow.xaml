<Window x:Class="Norcom.Admin.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Norcom.Admin.ViewModels"
        xmlns:views="clr-namespace:Norcom.Admin.Views"
        Title="NORCOM Admin 1.4.0"
        Width="1180" Height="760"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#070A12"
        Foreground="#F4FBFF"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Icon="/Assets/norcom-admin.ico"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border x:Name="TitleBar" Background="#0C1220" MouseLeftButtonDown="DragWindow" Padding="14,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Full" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="FullClick"/>
          <Button Content="Minimize" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="MinClick" AutomationProperties.AutomationId="Minimize" AutomationProperties.Name="Minimize"/>
          <Button Content="Maximize" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="MaxClick" AutomationProperties.AutomationId="Maximize" AutomationProperties.Name="Maximize"/>
          <Button Content="Close" Style="{StaticResource PinkButton}" Margin="0" Click="CloseClick" AutomationProperties.AutomationId="Close" AutomationProperties.Name="Close"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#00E5FF" Offset="0"/>
                <GradientStop Color="#FF3DB8" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="N" FontWeight="Bold" Foreground="#061018" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="NORCOM Admin" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock>
              <Run Text="{Binding VersionText, Mode=OneWay}"/>
              <Run Text=" · "/>
              <Run Text="{Binding LaneText, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Height="3">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#00E5FF" Offset="0"/>
          <GradientStop Color="#7CFFB2" Offset="0.45"/>
          <GradientStop Color="#FF3DB8" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="188"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#0B1120" BorderBrush="#1C3148" BorderThickness="0,0,1,0" Padding="12,16">
        <StackPanel>
          <Button Content="Dashboard" Style="{StaticResource NavButton}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:AdminPage.Dashboard}" Tag="{Binding IsDashboard}"/>
          <Button Content="Players" Style="{StaticResource NavButton}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:AdminPage.Players}" Tag="{Binding IsPlayers}"/>
          <Button Content="Console" Style="{StaticResource NavButton}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:AdminPage.Console}" Tag="{Binding IsConsole}"/>
          <Button Content="Settings" Style="{StaticResource NavButton}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:AdminPage.Settings}" Tag="{Binding IsSettings}"/>
          <Button Content="Backups" Style="{StaticResource NavButton}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:AdminPage.Backups}" Tag="{Binding IsBackups}"/>
          <Button Content="Crashes" Style="{StaticResource NavButton}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:AdminPage.Crashes}" Tag="{Binding IsCrashes}"/>
          <Button Content="Bank" Style="{StaticResource NavButton}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:AdminPage.Economy}" Tag="{Binding IsEconomy}"/>
          <Button Content="Configs" Style="{StaticResource NavButton}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:AdminPage.Configs}" Tag="{Binding IsConfigs}"/>
          <Button Content="Publish" Style="{StaticResource NavButton}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:AdminPage.Publish}" Tag="{Binding IsPublish}"/>
          <Button Content="Auto-fix" Style="{StaticResource NavButton}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:AdminPage.AutoFix}" Tag="{Binding IsAutoFix}"/>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="18">
        <views:DashboardView DataContext="{Binding Ops}" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Dashboard}"/>
        <views:PlayersView DataContext="{Binding Ops}" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Players}"/>
        <views:ConsoleView DataContext="{Binding Ops}" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Console}"/>
        <views:SettingsView DataContext="{Binding Settings}" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Settings}"/>
        <views:BackupsView DataContext="{Binding Ops}" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Backups}"/>
        <views:CrashesView DataContext="{Binding Ops}" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Crashes}"/>
        <views:EconomyView DataContext="{Binding}" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Economy}"/>
        <views:ConfigsView DataContext="{Binding Configs}" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Configs}"/>
        <views:PublishView DataContext="{Binding Publish}" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=Publish}"/>
        <views:AutoFixView DataContext="{Binding AutoFix}" Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PageVis}, ConverterParameter=AutoFix}"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
