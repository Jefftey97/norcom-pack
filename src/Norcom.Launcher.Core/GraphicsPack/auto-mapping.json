    "fullscreen": "true",
    "exclusiveFullscreen": "false",
    "macFullscreenMenuVisibility": "false"
  },
  "defaultTierIfUnknown": "high",
  "visualPathTier": "ultra",
  "screenOptionCount": 296,
  "shaderKeysPerTier": 298,
  "gpuTierRules": [
    {
      "tier": "low",
      "when": "integrated OR vramGB < 4"
    },
    {
      "tier": "medium",
      "when": "dedicated AND 4 <= vramGB < 6"
    },
    {
      "tier": "medium_high",
      "when": "dedicated AND 6 <= vramGB < 8"
    },
    {
      "tier": "high",
      "when": "dedicated AND 8 <= vramGB < 12"
    },
    {
      "tier": "ultra",
      "when": "dedicated AND vramGB >= 12"
    }
  ],
  "hostExample": {
    "gpu": "RTX 3070",
    "realVramGB": 8,
    "recommendedTier": "high",
    "note": "WMI may show 4GB; use NVAPI/DXGI for real 8GB"
  },
  "fpsBiasNotes": [
    "Shadow quality capped at Medium(2) even Ultra (matches official Complementary Ultra shadow quality)",
    "Shadow distance ~80% of RD; Iris maxShadow aligned to RD",
    "Light shafts quality 1-2 (some shafts) never 3-4",
    "POM off \u2014 Alacrity has no heightmaps",
    "RP_MODE Basic on Low else Integrated PBR+; never labPBR without maps",
    "WSR/motion blur/lens flare/puddles/nebulae/nether storm/cloud shadows OFF",
    "Colored lighting 0 until High(128)/Ultra(192)",
    "Modest vanilla RD + Distant Horizons for far view = FPS",
    "VSync off maxFps 260; borderless fullscreen=true exclusiveFullscreen=false",
    "Alacrity ONLY resource pack (continuity CTM helpers allowed)"
  ],
