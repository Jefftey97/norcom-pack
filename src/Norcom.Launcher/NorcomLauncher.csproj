<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace></RootNamespace>
    <AssemblyName>NorcomLauncher</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>2.0.37</Version>
    <FileVersion>2.0.37.0</FileVersion>
    <InformationalVersion>2.0.37</InformationalVersion>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <Product>NORCOM Launcher</Product>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Norcom.Launcher.Core\Norcom.Launcher.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0">
      <ExcludeAssets>analyzers</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="controls\neonmark.baml" LogicalName="controls/neonmark.baml" />
    <EmbeddedResource Include="views\shellwindow.baml" LogicalName="views/shellwindow.baml" />
    <EmbeddedResource Include="views\homeview.baml" LogicalName="views/homeview.baml" />
    <EmbeddedResource Include="assets\norcom.ico" LogicalName="assets/norcom.ico" />
    <EmbeddedResource Include="views\splashwindow.baml" LogicalName="views/splashwindow.baml" />
    <EmbeddedResource Include="views\settingsview.baml" LogicalName="views/settingsview.baml" />
    <EmbeddedResource Include="theme\colors.baml" LogicalName="theme/colors.baml" />
    <EmbeddedResource Include="assets\fonts\orbitron.ttf" LogicalName="assets/fonts/orbitron.ttf" />
    <EmbeddedResource Include="assets\fonts\exo2.ttf" LogicalName="assets/fonts/exo2.ttf" />
    <EmbeddedResource Include="app.baml" LogicalName="app.baml" />
  </ItemGroup>
  <Target Name="StripMvvmGenerators" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Filename)').Contains('CommunityToolkit'))" />
    </ItemGroup>
  </Target>
</Project>
