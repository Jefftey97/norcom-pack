<UserControl x:Class="Norcom.Launcher.Views.GameSwitcher" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="GAME" Style="{StaticResource Eyebrow}"/>
  <WrapPanel Margin="0,8,0,8">
   <Button Content="Minecraft" Command="{Binding SelectGameCommand}" CommandParameter="minecraft" AutomationProperties.Name="Choose Minecraft">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,10,10"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGameId}" Value="minecraft"><Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/><Setter Property="Background" Value="#153047"/></DataTrigger></Style.Triggers></Style></Button.Style>
   </Button>
   <Button Content="Project Zomboid" Command="{Binding SelectGameCommand}" CommandParameter="zomboid" AutomationProperties.Name="Choose Project Zomboid">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,10,10"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGameId}" Value="zomboid"><Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/><Setter Property="Background" Value="#153047"/></DataTrigger></Style.Triggers></Style></Button.Style>
   </Button>
  </WrapPanel>
  <TextBlock Text="{Binding GamePickerDetail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
 </StackPanel>
</UserControl>
