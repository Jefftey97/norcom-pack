<UserControl x:Class="Norcom.Launcher.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" SizeChanged="OnSizeChanged">
 <ScrollViewer><StackPanel Margin="24,6,24,12">
  <Grid x:Name="Overview"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="PlayCard" Style="{StaticResource Card}" Margin="0,0,18,18"><StackPanel>
    <TextBlock Text="WELCOME TO NORCOM" Style="{StaticResource Eyebrow}"/><TextBlock Text="Your next session starts here." FontSize="30" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <TextBlock Text="Your pack, your settings, your server. Minecraft opens in Prism. Project Zomboid opens in Steam." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
    <TextBlock Text="GAME" Style="{StaticResource Eyebrow}"/>
    <WrapPanel Margin="0,8,0,8"><Button Content="Minecraft" Command="{Binding SelectGameCommand}" CommandParameter="minecraft" Margin="0,0,10,10" AutomationProperties.Name="Choose Minecraft"/><Button Content="Project Zomboid" Command="{Binding SelectGameCommand}" CommandParameter="zomboid" Margin="0,0,10,10" AutomationProperties.Name="Choose Project Zomboid"/></WrapPanel>
    <TextBlock Text="{Binding GamePickerDetail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock Visibility="{Binding IsZomboid,Converter={StaticResource BooleanVisibility}}" Text="Play syncs the server's mod list from the pack, then connects in Steam. The first time, subscribe to any Workshop mods NORCOM names. You only need to own Project Zomboid." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <StackPanel Visibility="{Binding ShowZomboidPassword,Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,12"><TextBlock Text="Server password, saved on this PC only. Leave blank if the server has none." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/><PasswordBox x:Name="ZomboidPassword" PasswordChanged="ZomboidPasswordChanged" AutomationProperties.Name="Project Zomboid server password"/></StackPanel>
    <WrapPanel><Button x:Name="PlayAction" Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" Style="{StaticResource PrimaryButton}" FontSize="20" Padding="44,14" MinWidth="200" AutomationProperties.Name="Play NORCOM Minecraft" Margin="0,0,10,10"/>
     <Button Content="Stop game" Click="StopClick" Style="{StaticResource CautionButton}" Visibility="{Binding GameRunning,Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,10" AutomationProperties.Name="Stop the Minecraft game started by NORCOM"/>
    </WrapPanel>
    <TextBlock Text="{Binding PlayAvailability}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,18"/>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><StackPanel>
     <TextBlock Text="{Binding ProgressLabel}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" Height="4" Margin="0,12,0,10" Foreground="{StaticResource BlueBrush}" Background="#202e42" AutomationProperties.Name="Pack preparation progress"/>
     <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource Muted}" FontSize="12"/>
    </StackPanel></Border>
   </StackPanel></Border>
   <Border x:Name="ServerCard" Grid.Column="1" Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="NORCOM SERVER" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding ServerHeadline}" FontSize="25" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12">
     <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Foreground" Value="{StaticResource BlueBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock><TextBlock Text="{Binding PlayersText}" FontSize="18" Margin="0,0,0,12"/><TextBlock Text="{Binding Motd}" Style="{StaticResource Muted}" Margin="0,0,0,12"/><TextBlock Text="{Binding ServerCheckedAt}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
    <WrapPanel><Button Content="Refresh status" Command="{Binding RefreshServerCommand}" Margin="0,0,8,8"/><Button Content="Discord" Command="{Binding OpenDiscordCommand}" IsEnabled="{Binding DiscordEnabled}" Margin="0,0,0,8"/></WrapPanel>
   </StackPanel></Border>
  </Grid>
  <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CLIENT PACK" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/><TextBlock Text="{Binding PinDetail}" Style="{StaticResource Muted}"/></StackPanel><Button Grid.Column="1" Content="Check pack" IsEnabled="{Binding CanManageClient}" Click="CheckPackClick" Margin="16,0,0,0" VerticalAlignment="Center"/></Grid></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ACCOUNT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Managed in Prism" Style="{StaticResource SectionTitle}"/><TextBlock Text="Sign in with Microsoft in Prism when prompted. NORCOM opens your instance there and does not read Prism’s accounts." Style="{StaticResource Muted}"/><TextBlock Text="Prism Launcher is a separate GPL program." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12"/><Button Content="Get Prism Launcher" Command="{Binding OpenPrismDownloadCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="LATEST FROM NORCOM" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding NewsText}" Style="{StaticResource Muted}"/></StackPanel></Border>
  <WrapPanel><Button Content="Game folder" Command="{Binding OpenGameFolderCommand}" Margin="0,0,10,10"/><Button Content="Screenshots" Command="{Binding OpenScreenshotsFolderCommand}" Margin="0,0,0,10"/></WrapPanel>
 </StackPanel></ScrollViewer>
</UserControl>
