<UserControl x:Class="Norcom.Launcher.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Norcom.Launcher.Views" SizeChanged="OnSizeChanged">
 <ScrollViewer><StackPanel Margin="24,0,24,16">
  <Grid x:Name="Overview"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="PlayCard" Style="{StaticResource Card}" Margin="0,0,18,18" Padding="28"><StackPanel>
    <TextBlock Text="READY TO PLAY" Style="{StaticResource Eyebrow}" Foreground="{StaticResource PinkBrush}"/>
    <TextBlock Text="Pick a game. Press Play." FontSize="32" FontWeight="Bold" Margin="0,0,0,6"/>
    <TextBlock Text="Everything else (updates, mods, settings, joining the server) happens by itself." Style="{StaticResource Muted}" Margin="0,0,0,18"/>
    <local:GameSwitcher/>
    <TextBlock Text="{Binding SessionNote}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <StackPanel Margin="0,0,0,14" Visibility="{Binding PasswordEnabled,Converter={StaticResource BooleanVisibility}}"><TextBlock Text="{Binding PasswordPrompt}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/><PasswordBox x:Name="ZomboidPassword" IsEnabled="{Binding PasswordEnabled}" PasswordChanged="ZomboidPasswordChanged" AutomationProperties.Name="Server password"/></StackPanel>
    <Button x:Name="PlayAction" Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" Style="{StaticResource PrimaryButton}" FontSize="22" FontWeight="Bold" Padding="40,16" MinHeight="64" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding PlayLabel}" Margin="0,4,0,10"/>
    <Button Content="Stop game" Click="StopClick" Style="{StaticResource CautionButton}" IsEnabled="{Binding CanStopSelectedGame}" Visibility="{Binding CanStopSelectedGame,Converter={StaticResource BooleanVisibility}}" HorizontalAlignment="Stretch" Margin="0,0,0,10" AutomationProperties.Name="Stop the game started by NORCOM"/>
    <TextBlock Text="{Binding PlayAvailability}" Style="{StaticResource Muted}" FontSize="12" TextAlignment="Center" Margin="0,0,0,16"/>
    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16,14" BorderBrush="#12ffffff" BorderThickness="1"><StackPanel>
     <TextBlock Text="{Binding ProgressLabel}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
     <Grid Height="8" Margin="0,10,0,8"><Border Background="#1c2638" CornerRadius="4"/>
      <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentGradient}" AutomationProperties.Name="Pack preparation progress"/></Grid>
     <TextBlock Text="{Binding ProgressDetail}" Style="{StaticResource Muted}" FontSize="12"/>
    </StackPanel></Border>
   </StackPanel></Border>
   <Border x:Name="ServerCard" Grid.Column="1" Style="{StaticResource Card}" Padding="26"><Grid>
   <StackPanel>
    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SelectedGameId}" Value="zomboid"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="MINECRAFT SERVER" Style="{StaticResource Eyebrow}"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
     <Ellipse Width="14" Height="14" Margin="0,4,12,0" VerticalAlignment="Top"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#6b7891"/><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="{StaticResource OkBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
     <TextBlock Text="{Binding ServerHeadline}" FontSize="24" FontWeight="Bold" AutomationProperties.LiveSetting="Polite" MaxWidth="320">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock></StackPanel>
    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16,12" Margin="0,0,0,14" BorderBrush="#12ffffff" BorderThickness="1"><StackPanel>
     <TextBlock Text="PLAYERS" Style="{StaticResource Eyebrow}" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}"/>
     <TextBlock Text="{Binding PlayersText}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
    <TextBlock Text="{Binding Motd}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
    <TextBlock Text="{Binding ServerCheckedAt}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,18"/>
    <WrapPanel><Button Content="Refresh" Command="{Binding RefreshServerCommand}" Margin="0,0,8,8" AutomationProperties.Name="Refresh server status"/><Button Content="Join the Discord" Command="{Binding OpenDiscordCommand}" IsEnabled="{Binding DiscordEnabled}" Margin="0,0,0,8"/></WrapPanel>
   </StackPanel>
   <StackPanel>
    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedGameId}" Value="zomboid"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
    <TextBlock Text="PROJECT ZOMBOID SERVER" Style="{StaticResource Eyebrow}"/>
    <TextBlock Text="Press Play to join" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16,12" Margin="0,0,0,14" BorderBrush="#12ffffff" BorderThickness="1">
     <TextBlock Text="The launcher can't check the Zomboid server's status yet. Play opens Steam and connects you; if the server is off, Zomboid will say so." Style="{StaticResource Muted}"/></Border>
    <TextBlock Text="Ask in Discord if you're not sure it's running." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18"/>
    <WrapPanel><Button Content="Join the Discord" Command="{Binding OpenDiscordCommand}" IsEnabled="{Binding DiscordEnabled}" Margin="0,0,0,8"/></WrapPanel>
   </StackPanel>
   </Grid></Border>
  </Grid>
  <Grid x:Name="Details"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <local:RamCard Grid.Row="0" Grid.Column="0" Margin="0,0,18,0"/>
   <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="CLIENT PACK" Style="{StaticResource Eyebrow}"/><TextBlock Text="Your mods stay in sync." Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding ClientPackDetail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/><Button Content="Check pack now" IsEnabled="{Binding CanManageClient}" Click="CheckPackClick" HorizontalAlignment="Left"/></StackPanel></Border>
   <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,18"><StackPanel><TextBlock Text="ACCOUNT" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding AccountTitle}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding AccountBody}" Style="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Text="{Binding AccountFine}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12" TextWrapping="Wrap"/><Button Content="{Binding AccountAction}" Command="{Binding OpenAccountActionCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
   <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="LATEST FROM NORCOM" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding NewsText}" Style="{StaticResource Muted}"/></StackPanel></Border>
  </Grid>
  <WrapPanel><Button Content="Open game folder" Command="{Binding OpenGameFolderCommand}" Margin="0,0,10,10"/><Button Content="Screenshots" Command="{Binding OpenScreenshotsFolderCommand}" Margin="0,0,0,10"/></WrapPanel>
 </StackPanel></ScrollViewer>
</UserControl>
