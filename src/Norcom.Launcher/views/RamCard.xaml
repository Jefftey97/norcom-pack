<UserControl x:Class="Norcom.Launcher.Views.RamCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource Card}"><StackPanel>
  <TextBlock Text="MEMORY" Style="{StaticResource Eyebrow}"/>
  <TextBlock Text="Room for this game." Style="{StaticResource SectionTitle}"/>
  <TextBlock Text="{Binding MemoryLabel}" FontSize="22"/>
  <Grid Height="14" Margin="0,14,0,0">
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition x:Name="GreenCol" Width="*"/>
     <ColumnDefinition x:Name="RedCol" Width="0"/>
    </Grid.ColumnDefinitions>
    <Border Background="#1f8a4c" CornerRadius="7,0,0,7"/>
    <Border Grid.Column="1" Background="#8f2d4a" CornerRadius="0,7,7,0"/>
   </Grid>
   <Grid>
    <Grid.ColumnDefinitions>
     <ColumnDefinition x:Name="BeforeMarker" Width="0"/>
     <ColumnDefinition Width="3"/>
     <ColumnDefinition x:Name="AfterMarker" Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="1" Background="{StaticResource BlueBrush}" Width="3"/>
   </Grid>
  </Grid>
  <Slider x:Name="MemoryControl" Minimum="{Binding RamFloorMb}" Maximum="{Binding RamSafeMaxMb}" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MemoryMb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Memory for this game in megabytes"/>
  <TextBlock Text="{Binding RamScaleCaption}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
  <TextBlock Text="{Binding RamWarning}" Foreground="{StaticResource PinkBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
 </StackPanel></Border>
</UserControl>
