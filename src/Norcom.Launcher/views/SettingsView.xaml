<UserControl x:Class="Norcom.Launcher.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:Norcom.Launcher.Core.Models;assembly=Norcom.Launcher.Core">
 <ScrollViewer><StackPanel Margin="24,6,24,12">
  <TextBlock Text="Make it yours." FontSize="30" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Your preferences stay on this PC." Style="{StaticResource Muted}" Margin="0,0,0,24"/>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GRAPHICS" Style="{StaticResource Eyebrow}"/><TextBlock Text="One preset. A consistent picture." Style="{StaticResource SectionTitle}"/><TextBlock Text="Choose a preset to apply the NORCOM graphics configuration. Auto chooses for this PC. In-game changes stay until you choose again or use Fix visuals." Style="{StaticResource Muted}" Margin="0,0,0,18"/>
   <WrapPanel IsEnabled="{Binding CanManageClient}"><Button Content="Low" Command="{Binding ApplyTierCommand}" CommandParameter="{x:Static core:GraphicsTier.Low}" Margin="0,0,10,10"/><Button Content="Medium" Command="{Binding ApplyTierCommand}" CommandParameter="{x:Static core:GraphicsTier.Medium}" Margin="0,0,10,10"/><Button Content="Medium high" Command="{Binding ApplyTierCommand}" CommandParameter="{x:Static core:GraphicsTier.MediumHigh}" Margin="0,0,10,10"/><Button Content="High" Command="{Binding ApplyTierCommand}" CommandParameter="{x:Static core:GraphicsTier.High}" Margin="0,0,10,10"/><Button Content="Ultra" Command="{Binding ApplyTierCommand}" CommandParameter="{x:Static core:GraphicsTier.Ultra}" Margin="0,0,10,10"/><Button Content="Auto · this PC" Command="{Binding ApplyAutoCommand}" Margin="0,0,0,10"/></WrapPanel>
   <TextBlock Text="{Binding TierSummary}" Foreground="{StaticResource BlueBrush}" FontSize="12" Margin="0,4,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MEMORY" Style="{StaticResource Eyebrow}"/><TextBlock Text="Room for your world." Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding MemoryLabel}" FontSize="22"/><Slider x:Name="MemoryControl" Minimum="2048" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MemoryMb,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Requested Minecraft memory in megabytes"/><TextBlock Text="2 GB — 16 GB requested. NORCOM checks available memory before launch and may lower the allocation to keep Windows responsive." Style="{StaticResource Muted}" FontSize="12"/></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="COMFORT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Keep the launcher comfortable." Style="{StaticResource SectionTitle}"/><CheckBox x:Name="ReduceMotionControl" Content="Reduce motion" IsChecked="{Binding ReduceMotion,Mode=TwoWay}"/><CheckBox Content="Pause motion while Minecraft is playing" IsChecked="{Binding PauseWhilePlaying,Mode=TwoWay}"/><CheckBox Content="Play launcher sounds" IsChecked="{Binding LauncherSounds,Mode=TwoWay}"/></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="REPAIR &amp; FILES" Style="{StaticResource Eyebrow}"/><TextBlock Text="A clear way back to ready." Style="{StaticResource SectionTitle}"/><TextBlock Text="Fix visuals reapplies your graphics preset and backs up changed files. Repair checks the pack and Java. Your saved worlds are preserved. Close Minecraft first." Style="{StaticResource Muted}" Margin="0,0,0,18"/><WrapPanel IsEnabled="{Binding CanManageClient}"><Button Content="Fix visuals" Command="{Binding FixVisualsCommand}" Margin="0,0,10,10"/><Button x:Name="RepairAction" Content="Repair client" Command="{Binding RepairCommand}" Margin="0,0,10,10"/><Button Content="Game folder" Command="{Binding OpenGameFolderCommand}" Margin="0,0,0,10"/></WrapPanel></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ABOUT &amp; SUPPORT" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding VersionText}" Style="{StaticResource SectionTitle}"/><TextBlock Text="Friends channel · signed updates · native Windows app" Style="{StaticResource Muted}"/><TextBlock Text="Updates preserve the working launcher for recovery. Opening NORCOM never starts the Minecraft server." Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,18"/><WrapPanel><Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" Margin="0,0,10,10"/><Button Content="Open logs" Click="OpenLogsClick" Margin="0,0,10,10"/><Button Content="Copy diagnostics" Click="CopyDiagnosticsClick" Margin="0,0,0,10"/></WrapPanel><Separator Margin="0,12,0,16" Background="{StaticResource LineBrush}"/><TextBlock Text="Send a redacted launcher report and recent launcher log only when you choose. Account files are not included." Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding CrashChannelStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12"/><Button Content="Send diagnostics…" Click="SendDiagnosticsClick" HorizontalAlignment="Left"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
