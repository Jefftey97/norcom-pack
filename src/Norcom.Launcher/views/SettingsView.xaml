<UserControl x:Class="Norcom.Launcher.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:Norcom.Launcher.Core.Models;assembly=Norcom.Launcher.Core" xmlns:local="clr-namespace:Norcom.Launcher.Views">
 <ScrollViewer><StackPanel Margin="24,6,24,12">
  <TextBlock Text="Make it yours." FontSize="30" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Launcher preferences stay on this PC. In-game settings for each game are on the Minecraft and Project Zomboid tabs. Server settings stay in Workstation Admin." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="COMFORT" Style="{StaticResource Eyebrow}"/><TextBlock Text="Keep the launcher comfortable." Style="{StaticResource SectionTitle}"/><CheckBox x:Name="ReduceMotionControl" Content="Reduce motion" IsChecked="{Binding ReduceMotion,Mode=TwoWay}"/><CheckBox Content="Pause motion while a game is playing" IsChecked="{Binding PauseWhilePlaying,Mode=TwoWay}"/><CheckBox Content="Play launcher sounds" IsChecked="{Binding LauncherSounds,Mode=TwoWay}"/></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="REPAIR &amp; FILES" Style="{StaticResource Eyebrow}"/><TextBlock Text="A clear way back to ready." Style="{StaticResource SectionTitle}"/><TextBlock Text="Fix visuals reapplies your graphics preset and backs up changed files. Repair checks the pack and Java. Your saved worlds are preserved. Close Minecraft first." Style="{StaticResource Muted}" Margin="0,0,0,18"/><WrapPanel IsEnabled="{Binding CanManageClient}"><Button Content="Fix visuals" Command="{Binding FixVisualsCommand}" Margin="0,0,10,10"/><Button x:Name="RepairAction" Content="Repair client" Command="{Binding RepairCommand}" Margin="0,0,10,10"/><Button Content="Game folder" Command="{Binding OpenGameFolderCommand}" Margin="0,0,0,10"/></WrapPanel></StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ABOUT &amp; SUPPORT" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding VersionText}" Style="{StaticResource SectionTitle}"/><TextBlock Text="Friends channel · signed updates · native Windows app" Style="{StaticResource Muted}"/><TextBlock Text="Updates preserve the working launcher for recovery. Opening NORCOM never starts the Minecraft server." Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,18"/><WrapPanel><Button Content="Check for updates" Command="{Binding CheckUpdatesCommand}" Margin="0,0,10,10"/><Button Content="Open logs" Click="OpenLogsClick" Margin="0,0,10,10"/><Button Content="Copy diagnostics" Click="CopyDiagnosticsClick" Margin="0,0,0,10"/></WrapPanel><Separator Margin="0,12,0,16" Background="{StaticResource LineBrush}"/><TextBlock Text="Send a redacted launcher report and recent launcher log only when you choose. Account files are not included." Style="{StaticResource Muted}" FontSize="12"/><TextBlock Text="{Binding CrashChannelStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12"/><Button Content="Send diagnostics…" Click="SendDiagnosticsClick" HorizontalAlignment="Left"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
