<Window x:Class="Norcom.Launcher.Views.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Norcom.Launcher.Views" xmlns:vm="clr-namespace:Norcom.Launcher.ViewModels" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="NORCOM Launcher" Width="1180" Height="800" MinWidth="560" MinHeight="420" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Loaded="OnLoaded" Closed="OnClosed" Activated="OnActivated">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderThickness="1" BorderBrush="{StaticResource LineBrush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Background="#0d1320"><Grid Margin="22,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="N" FontSize="23" Foreground="{StaticResource PinkBrush}" FontWeight="Bold" Margin="0,0,10,0"/><TextBlock Text="NORCOM" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/><TextBlock Text="LAUNCHER" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Width="40" Padding="0" MinHeight="32" Margin="2,6" Click="MinimizeClick" AutomationProperties.Name="Minimize launcher"/><Button Content="□" Width="40" Padding="0" MinHeight="32" Margin="2,6" Click="MaximizeClick" AutomationProperties.Name="Maximize or restore launcher"/><Button Content="×" Width="40" Padding="0" MinHeight="32" Margin="2,6" Click="CloseClick" AutomationProperties.Name="Close launcher"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1" Margin="24,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal">
   <Button Content="_Home" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:LauncherPage.Home}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsHome}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/><Setter Property="Background" Value="#153047"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
   <Button Content="_Settings" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:LauncherPage.Settings}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsSettings}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/><Setter Property="Background" Value="#153047"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
   <Button Content="_Graphics" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:LauncherPage.Graphics}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsGraphics}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource BlueBrush}"/><Setter Property="Background" Value="#153047"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
  </StackPanel><TextBlock Grid.Column="1" Text="{Binding VersionText}" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/></Grid>
  <Grid Grid.Row="2"><views:HomeView x:Name="HomePanel" Visibility="{Binding IsHome,Converter={StaticResource BooleanVisibility}}"/><views:SettingsView x:Name="SettingsPanel" Visibility="{Binding IsSettings,Converter={StaticResource BooleanVisibility}}"/><views:GraphicsMenuView x:Name="GraphicsPanel" Visibility="{Binding IsGraphics,Converter={StaticResource BooleanVisibility}}"/></Grid>
  <Border Grid.Row="3" Background="#0d1320" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12"><TextBlock Text="{Binding StatusLine}" FontSize="12" Foreground="{StaticResource MutedBrush}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Launcher status"/></Border>
 </Grid></Border>
</Window>
