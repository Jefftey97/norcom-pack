<Window x:Class="Norcom.Launcher.Views.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Norcom.Launcher.Views" xmlns:vm="clr-namespace:Norcom.Launcher.ViewModels" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="NORCOM Launcher" Width="1180" Height="800" MinWidth="560" MinHeight="420" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Loaded="OnLoaded" Closed="OnClosed" Activated="OnActivated">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="NavHome" TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsHome}" Value="True"><Setter Property="Background" Value="{StaticResource SelectedGradient}"/><Setter Property="BorderBrush" Value="#66ff3ea5"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="NavMinecraft" TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsMinecraftPage}" Value="True"><Setter Property="Background" Value="{StaticResource SelectedGradient}"/><Setter Property="BorderBrush" Value="#66ff3ea5"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="NavZomboid" TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsZomboidPage}" Value="True"><Setter Property="Background" Value="{StaticResource SelectedGradient}"/><Setter Property="BorderBrush" Value="#66ff3ea5"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="NavSettings" TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSettings}" Value="True"><Setter Property="Background" Value="{StaticResource SelectedGradient}"/><Setter Property="BorderBrush" Value="#66ff3ea5"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Border BorderThickness="1" BorderBrush="{StaticResource LineBrush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Rectangle Grid.RowSpan="3" Fill="{StaticResource BackdropGlow}" IsHitTestVisible="False"/>
  <Border Background="#cc0a0f1b" BorderBrush="#14ffffff" BorderThickness="0,0,0,1"><Grid Margin="22,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="NORCOM" FontSize="20" FontWeight="Black" Foreground="{StaticResource WordmarkGradient}" VerticalAlignment="Center"/><TextBlock Text="LAUNCHER" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="12,3,0,0" VerticalAlignment="Center"/></StackPanel>
   <Border Grid.Column="1" Style="{StaticResource Pill}" VerticalAlignment="Center" Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{Binding ServerCheckedAt}"><StackPanel Orientation="Horizontal">
    <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#6b7891"/><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="{StaticResource OkBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
    <TextBlock Text="{Binding ServerHeadline}" FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center"/></StackPanel></Border>
   <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="—" Width="40" Padding="0" MinHeight="32" Margin="2,6" Background="Transparent" BorderBrush="Transparent" Click="MinimizeClick" AutomationProperties.Name="Minimize launcher"/><Button Content="□" Width="40" Padding="0" MinHeight="32" Margin="2,6" Background="Transparent" BorderBrush="Transparent" Click="MaximizeClick" AutomationProperties.Name="Maximize or restore launcher"/><Button Content="×" Width="40" Padding="0" MinHeight="32" Margin="2,6" Background="Transparent" BorderBrush="Transparent" Click="CloseClick" AutomationProperties.Name="Close launcher"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="98"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#99090d17" BorderBrush="#10ffffff" BorderThickness="0,0,1,0" Padding="10,16"><DockPanel LastChildFill="False">
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" Style="{StaticResource Muted}" FontSize="10" TextAlignment="Center" Margin="0,8,0,0"/>
    <StackPanel DockPanel.Dock="Top">
     <Button Style="{StaticResource NavHome}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:LauncherPage.Home}" AutomationProperties.Name="Home"><StackPanel><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><AccessText Text="_Home" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource NavMinecraft}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:LauncherPage.Minecraft}" AutomationProperties.Name="Minecraft settings"><StackPanel><TextBlock Text="&#xE7B8;" Style="{StaticResource NavIcon}"/><AccessText Text="_Minecraft" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource NavZomboid}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:LauncherPage.Zomboid}" AutomationProperties.Name="Project Zomboid settings"><StackPanel><TextBlock Text="&#xE7FC;" Style="{StaticResource NavIcon}"/><AccessText Text="_Zomboid" HorizontalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource NavSettings}" Command="{Binding SelectPageCommand}" CommandParameter="{x:Static vm:LauncherPage.Settings}" AutomationProperties.Name="Launcher settings"><StackPanel><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><AccessText Text="_Settings" HorizontalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
   </DockPanel></Border>
   <Grid Grid.Column="1" Margin="0,16,0,0"><views:HomeView x:Name="HomePanel" Visibility="{Binding IsHome,Converter={StaticResource BooleanVisibility}}"/><views:GraphicsMenuView x:Name="MinecraftPanel" GameId="minecraft" Visibility="{Binding IsMinecraftPage,Converter={StaticResource BooleanVisibility}}"/><views:GraphicsMenuView x:Name="ZomboidPanel" GameId="zomboid" Visibility="{Binding IsZomboidPage,Converter={StaticResource BooleanVisibility}}"/><views:SettingsView x:Name="SettingsPanel" Visibility="{Binding IsSettings,Converter={StaticResource BooleanVisibility}}"/></Grid>
  </Grid>
  <Border Grid.Row="2" Background="#cc0a0f1b" BorderBrush="#14ffffff" BorderThickness="0,1,0,0" Padding="24,10"><TextBlock Text="{Binding StatusLine}" FontSize="12" Foreground="{StaticResource MutedBrush}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Launcher status"/></Border>
 </Grid></Border>
</Window>
