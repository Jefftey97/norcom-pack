<Window x:Class="Norcom.Launcher.Views.SplashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Opening NORCOM" Width="420" Height="190" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}" ShowInTaskbar="False">
 <Border BorderBrush="{StaticResource BlueBrush}" BorderThickness="1" Padding="30"><StackPanel><TextBlock Text="NORCOM" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Opening your launcher…" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,20"/><ProgressBar x:Name="OpeningProgress" IsIndeterminate="True" Height="3" Foreground="{StaticResource BlueBrush}"/></StackPanel></Border>
</Window>
