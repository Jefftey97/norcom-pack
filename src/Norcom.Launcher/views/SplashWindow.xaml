<Window x:Class="Norcom.Launcher.Views.SplashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Opening NORCOM" Width="420" Height="190" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="{StaticResource BackgroundBrush}" ShowInTaskbar="False">
 <Border BorderBrush="{StaticResource AccentGradient}" BorderThickness="1" Padding="30"><Grid><Rectangle Fill="{StaticResource BackdropGlow}" Margin="-30" IsHitTestVisible="False"/><StackPanel><TextBlock Text="NORCOM" FontSize="30" FontWeight="Black" Foreground="{StaticResource WordmarkGradient}"/><TextBlock Text="Opening your launcher…" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,22"/><ProgressBar x:Name="OpeningProgress" IsIndeterminate="True" Height="4" Background="#1c2638" BorderThickness="0" Foreground="{StaticResource AccentGradient}"/></StackPanel></Grid></Border>
</Window>
